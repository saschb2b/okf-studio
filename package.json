{
  "name": "okf-viewer",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "Explore connected knowledge with the agents you already use.",
  "scripts": {
    "dev": "vite",
    "build": "tsgo --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:ds": "node scripts/check-design-system.mjs",
    "check:theme": "pnpm check:tokens && pnpm check:contrast && pnpm check:ds",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --project unit --project component",
    "test:watch": "vitest --project unit --project component",
    "test:integration": "vitest run --project integration",
    "test:frontend": "pnpm test && pnpm test:integration && pnpm test:stories",
    "test:stories": "vitest run --project storybook",
    "test:agent-benchmarks": "node --test scripts/okf-agent-benchmark.test.mjs && node scripts/okf-agent-benchmark.mjs check",
    "test:network": "cargo test -p okf-viewer remote::tests::fetches_and_extracts_a_real_github_subpath -- --ignored --exact",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@cosmograph/cosmos": "2.0.0-beta.20",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nivo/circle-packing": "0.99.0",
    "@nivo/sunburst": "0.99.0",
    "@nivo/theming": "0.99.0",
    "@nivo/treemap": "0.99.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dompurify": "^3",
    "gemoji": "^8.1.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.23.0",
    "marked": "^15",
    "marked-emoji": "^2.0.3",
    "marked-footnote": "^1.4.0",
    "mermaid": "^11.16.0",
    "react": "^19",
    "react-dom": "^19",
    "shiki": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/dompurify": "^3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^5",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "axe-core": "^4.12.1",
    "babel-plugin-react-compiler": "^1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.7.0",
    "jsdom": "^25",
    "lodash": "^4.18.1",
    "playwright": "^1.61.1",
    "storybook": "^10.5.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "use-sync-external-store": "^1.6.0",
    "vite": "^6",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "@storybook/addon-vitest@10.5.2": "patches/@storybook__addon-vitest@10.5.2.patch"
    }
  }
}
