{
  "name": "okf-viewer",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "description": "Explore connected knowledge with the agents you already use.",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/typescript-7/bin/tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:ds": "node scripts/check-design-system.mjs",
    "check:agents": "node scripts/refresh-agent-catalog.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "check:capabilities": "node scripts/pin-capabilities.mjs",
    "capabilities:pin": "node scripts/pin-capabilities.mjs --write",
    "check:version": "node scripts/check-version.mjs",
    "clean:rust": "cargo clean",
    "refresh:agents": "node scripts/refresh-agent-catalog.mjs --write",
    "version:set": "node scripts/check-version.mjs --set",
    "version:sync": "node scripts/check-version.mjs --write",
    "check:theme": "pnpm check:tokens && pnpm check:contrast && pnpm check:ds",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "test": "vitest run --project unit --project component",
    "test:watch": "vitest --project unit --project component",
    "test:integration": "vitest run --project integration",
    "test:frontend": "pnpm test && pnpm test:integration && pnpm test:stories",
    "test:stories": "vitest run --project storybook",
    "test:agent-benchmarks": "node --test scripts/okf-agent-benchmark.test.mjs && node scripts/okf-agent-benchmark.mjs check",
    "test:network": "cargo test -p okf-viewer remote::tests::fetches_and_extracts_a_real_github_subpath -- --ignored --exact",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@cosmograph/cosmos": "2.0.0-beta.20",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nivo/circle-packing": "0.99.0",
    "@nivo/sunburst": "0.99.0",
    "@nivo/theming": "0.99.0",
    "@nivo/treemap": "0.99.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "dompurify": "^3.4.17",
    "gemoji": "^8.1.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "marked-emoji": "^3.0.0",
    "marked-footnote": "^1.4.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-mcp": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "lodash": "^4.18.1",
    "playwright": "^1.64.1",
    "storybook": "^10.6.3",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.72.0",
    "use-sync-external-store": "^1.7.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
