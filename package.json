    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dompurify": "^3",
    "katex": "^0.17.0",
    "marked": "^15",
    "react": "^19",
    "react-dom": "^19",
    "shiki": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6",
