---
// Base document shell. Imports the design-system token + component CSS (the
// bridge from the ODSF bundle) and the page styles, in cascade order.
//
// The two typefaces the design system names are self-hosted, not fetched from
// a font CDN: Astro bundles the woff2 files into the site's own assets, so
// there is no third-party request on a page whose subject is local-first
// software. Only the latin subsets are ever downloaded (each @font-face
// carries a unicode-range), and font-display: swap keeps the system fallback
// visible until they land.
// Inter's "standard" build carries both the weight and the optical-size axis,
// so `font-optical-sizing: auto` can tighten the 52px hero headline without a
// second file (73KB latin, against 48KB for weight alone).
import "@fontsource-variable/inter/standard.css";
import "@fontsource-variable/jetbrains-mono/wght.css";

import "../styles/design-system/tokens.css";
import "../styles/design-system/components.css";
import "../styles/site.css";

import { repo, releasesLatest, license, softwareVersion } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Route path relative to the site base, e.g. "product/explore/". "" is home. */
  path?: string;
}

const {
  title = "OKF Studio: explore connected knowledge with your agents",
  description =
    "A local-first desktop workspace for exploring connected Open Knowledge Format bundles with the agents you already use. Free and open source for Windows, macOS, and Linux.",
  path = "",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site;
const abs = (p: string) => (site ? new URL(p, site).href : p);

const canonical = abs(`${base}${path}`);
const ogImage = abs(`${base}og.png`);
const siteName = "OKF Studio";
const isHome = path === "";

// Structured data for richer search results; the product record lives on the
// homepage only, so route pages don't duplicate the claim.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "OKF Studio",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Windows, macOS, Linux",
  description,
  url: canonical,
  image: ogImage,
  downloadUrl: releasesLatest,
  softwareVersion,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: "Sascha Becker" },
  license,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sascha Becker" />
    <meta
      name="keywords"
      content="OKF Studio, Open Knowledge Format, ODSF, knowledge graph, concept graph, desktop app, Tauri, markdown, agent knowledge"
    />
    <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OKF Studio: explore connected knowledge with your agents. A local-first desktop workspace showing a bundle as a concept graph beside the reader." />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="OKF Studio: explore connected knowledge with your agents. A local-first desktop workspace showing a bundle as a concept graph beside the reader." />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
