---
// Base document shell. Imports the design-system token + component CSS (the
// bridge from the ODSF bundle) and the page styles, in cascade order.
import "../styles/design-system/tokens.css";
import "../styles/design-system/components.css";
import "../styles/site.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "OKF Viewer: read your knowledge as a graph",
  description =
    "A fast, native desktop reader for Open Knowledge Format (OKF) bundles. Point it at a folder and explore your knowledge as an interactive concept graph. Free and open source for Windows, macOS, and Linux.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site;
const abs = (path: string) => (site ? new URL(path, site).href : path);

const canonical = abs(base);
const ogImage = abs(`${base}og.png`);
const siteName = "OKF Viewer";
const repo = "https://github.com/saschb2b/okf-viewer";

// Structured data for richer search results.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "OKF Viewer",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Windows, macOS, Linux",
  description,
  url: canonical,
  image: ogImage,
  downloadUrl: `${repo}/releases/latest`,
  softwareVersion: "0.2.6",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: "Sascha Becker" },
  license: `${repo}/blob/main/LICENSE`,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sascha Becker" />
    <meta
      name="keywords"
      content="OKF Viewer, Open Knowledge Format, ODSF, knowledge graph, concept graph, desktop app, Tauri, markdown, agent knowledge"
    />
    <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OKF Viewer showing a knowledge bundle as a concept graph beside the reader" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="OKF Viewer showing a knowledge bundle as a concept graph beside the reader" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
