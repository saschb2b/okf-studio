---
// Download: the canonical download surface. Platforms, version, requirements,
// and release links come from src/data/site.ts; nothing is duplicated here.
import Shell from "../components/Shell.astro";
import {
  version,
  repo,
  releases,
  migrationNotes,
  downloads,
  aptBase,
  aptKey,
  aptKeyring,
  aptSource,
} from "../data/site";

// One block, so it survives a copy-paste as a unit. Every path and URL comes
// from site.ts, because a keyring path that drifts from the one the source file
// names fails with a signature error rather than a missing-file error.
const aptInstall = `sudo install -d -m 0755 /etc/apt/keyrings
curl -fsSL ${aptKey} | sudo tee ${aptKeyring} > /dev/null
sudo tee ${aptSource} > /dev/null <<'EOF'
Types: deb
URIs: ${aptBase}
Suites: stable
Components: main
Architectures: amd64
Signed-By: ${aptKeyring}
EOF
sudo apt update && sudo apt install okf-studio`;
---

<Shell
  title="Download OKF Studio for Windows and Linux"
  description="Get the current OKF Studio release for Windows (.msi, .exe) or Linux (.deb, AppImage), free and open source. macOS builds from source."
  path="download/"
>
  <main id="main">
    <section class="section">
      <div class="container">
        <header class="page-head">
          <span class="eyebrow">Download · {version}</span>
          <h1 class="page-head__title">Get OKF Studio</h1>
          <p class="page-head__lede">Free and open source. Pick your platform.</p>
        </header>

        <div class="band">
          <div class="download__row">
            {
              downloads.map((d) => (
                <a class="dl-btn" href={d.href}>
                  <span class="dl-btn__glyph" aria-hidden="true">{d.glyph}</span>
                  <span class="dl-btn__text">
                    <span class="dl-btn__os">{d.os}</span>
                    <span class="dl-btn__meta">{d.meta}</span>
                  </span>
                  <span class="dl-btn__arrow" aria-hidden="true">↓</span>
                </a>
              ))
            }
          </div>
          <p class="download__note">
            {version} · builds are unsigned, so your OS may warn on first launch · <a href={releases}>all releases and notes</a>
          </p>
        </div>

        <div class="cap-group">
          <h2 class="cap-group__title">Ubuntu, with updates handled for you</h2>
          <p class="cap-group__lede">
            Install from the APT repository and Studio upgrades like the rest of
            your system: <code>apt upgrade</code> picks up each release, and
            unattended-upgrades can apply them without you being there. Run this
            once.
          </p>
          <pre class="snippet"><code>{aptInstall}</code></pre>
          <p class="download__note">
            The repository is signed. apt refuses it outright if the signature
            does not match the key you installed, so a tampered mirror fails
            loudly instead of installing. The direct downloads above stay
            available if you would rather not add a repository.
          </p>
        </div>

        <div class="cap-group">
          <h2 class="cap-group__title">Good to know</h2>
          <div class="features">
            <article class="feature-card">
              <h3 class="feature-card__title">Requirements</h3>
              <p class="feature-card__body">
                A small native Tauri app: Windows x64 (.msi or .exe) and Linux
                (.deb or AppImage). No account, no telemetry, no background
                services.
              </p>
            </article>
            <article class="feature-card">
              <h3 class="feature-card__title">macOS</h3>
              <p class="feature-card__body">
                No signed macOS build yet; <a href={repo}>build from source</a> with the instructions in the repository.
              </p>
            </article>
            <article class="feature-card">
              <h3 class="feature-card__title">Upgrading from OKF Viewer?</h3>
              <p class="feature-card__body">
                Settings and agent profiles stay in place. Open each retained
                local folder once so Studio can reach it again. See the <a href={migrationNotes}>migration notes</a>.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>
  </main>
</Shell>
