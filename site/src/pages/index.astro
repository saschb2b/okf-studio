---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
const icon = `${base}icon.svg`;
const shotGraph = `${base}screenshot-graph.webp`;
const shotReader = `${base}screenshot-reader.webp`;
const shotDs = `${base}screenshot-ds.webp`;

const repo = "https://github.com/saschb2b/okf-viewer";
const releasesLatest = `${repo}/releases/latest`;
const releases = `${repo}/releases`;
const migrationNotes = `${repo}/blob/main/docs/product/migration-notes.md`;
const version = "v0.2.7";

const okfSpec = "https://github.com/GoogleCloudPlatform/knowledge-catalog/tree/main/okf";
const odsfSpec = "https://saschb2b.github.io/Open-Design-System-Format/";

const features = [
  {
    glyph: "✦",
    title: "Agent workspace",
    body: "Connect ACP agents beside the graph and reader, or run Studio Agent through a local endpoint or an API-key-backed OpenAI-compatible service. Each external process is bound to the active Rust-granted bundle before launch and cannot be reused for another bundle. Run parallel threads on one connection and switch among live agents without interrupting their work. Studio keeps API keys in your operating system's credential store. Every path gets packaged OKF guidance, bounded tools, and reviewed staging. Native turns reject unadvertised tools before dispatch and refuse provider redirects. You keep or reject changes before anything reaches the bundle. Each thread shows a Rust-produced security profile with file, network, credential, process, lifetime, and stop conditions. Saved custom ACP commands can opt into a verified Linux Bubblewrap profile that mounts the bundle and executable read-only, hides protected paths, and disables host networking. Standard remains the default, subscription agents keep their normal access, unsupported hosts are explicit, and unattended work remains locked.",
  },
  {
    glyph: "◱",
    title: "Knowledge as a graph",
    body: "Explore concepts, links, and structure visually, not a wall of files: a force-directed graph, a zoomable treemap, a sunburst, or nested circles. Your pick is remembered.",
  },
  {
    glyph: "⬡",
    title: "Any conformant bundle",
    body: "Reads Open Knowledge Format & ODSF bundles from any producer. Open a local folder, or explicitly download and cache a GitHub URL on your machine. Rust records that choice and limits readers, assets, watchers, and agents to bundle roots found by its scan.",
  },
  {
    glyph: "⧉",
    title: "Tabs & windows",
    body: "Ctrl+click opens a concept in a new tab with its own history. Drag to reorder, or tear one off into its own window.",
  },
  {
    glyph: "◎",
    title: "Peek before you open",
    body: "Hover any concept link for an instant preview of its type, title, and first lines, before deciding it's worth a tab.",
  },
  {
    glyph: "⌕",
    title: "Built for the deep dive",
    body: "An overview page to orient, faceted queries like type:Table degree>5, and a lineage panel that traces dependencies across hops.",
  },
  {
    glyph: "⚡",
    title: "Native & fast",
    body: "A Tauri desktop app for Windows, macOS, and Linux. Small, quick, no browser bloat.",
  },
  {
    glyph: "✓",
    title: "Conformance built in",
    body: "Validation surfaces issues inline; a tolerant reader never rejects a sloppy bundle.",
  },
  {
    glyph: "◐",
    title: "Design-system aware",
    body: "Renders ODSF design tokens and live HTML/CSS examples right in the reader.",
  },
  {
    glyph: "❯",
    title: "A real reader",
    body: "The whole extended markdown set: highlighted code, math, Mermaid diagrams, footnotes, task lists, emoji, embedded HTML. Plus zoomable images, live reload, and keyboard-first navigation.",
  },
];

// The four visualizations of one bundle (Studio's own docs, as shipped).
const vizzes = [
  {
    src: `${base}screenshot-viz-graph.webp`,
    title: "Graph",
    body: "The force-directed network: what cites what, hubs and clusters at a glance. Double-click a node to expand its neighborhood.",
    alt: "OKF Studio's force-directed graph of a documentation bundle, nodes colored by concept type",
  },
  {
    src: `${base}screenshot-viz-treemap.webp`,
    title: "Treemap",
    body: "Nested rectangles sized by how much is written: what's big, what's inside what. Click a group to drill in.",
    alt: "OKF Studio's treemap view: nested rectangles grouped by section, sized by content",
  },
  {
    src: `${base}screenshot-viz-sunburst.webp`,
    title: "Sunburst",
    body: "The whole hierarchy as concentric rings. Click a sector to re-root on it; the center takes you back up.",
    alt: "OKF Studio's sunburst view: the bundle hierarchy as labeled concentric rings",
  },
  {
    src: `${base}screenshot-viz-pack.webp`,
    title: "Circle packing",
    body: "Groups within groups as nested circles, with a smooth zoom as you drill down and out.",
    alt: "OKF Studio's circle-packing view: concepts as nested circles grouped by section",
  },
];

const downloads = [
  { glyph: "⊞", os: "Windows", meta: ".msi · .exe · x64", href: releasesLatest },
  { glyph: "◈", os: "Linux", meta: ".deb · AppImage", href: releasesLatest },
];
---

<Base>
  <a class="skip-link" href="#main">Skip to content</a>

  {/* The nav is a floating pill: sticky above the canvas, translucent, so the
      primary Download action stays reachable while scrolling — without going
      back to a page-wide bordered strip. See design-system/components/nav.md. */}
  <header class="topbar">
    <nav class="site-nav topbar__inner" aria-label="Primary">
      <a class="site-nav__brand" href={base}>
        <img class="site-nav__logo" src={icon} alt="" width="28" height="28" />
        OKF Studio
      </a>
      <div class="site-nav__links">
        <a class="site-nav__link" href="#formats">What is OKF?</a>
        <a class="site-nav__link" href="#features">Features</a>
        <a class="site-nav__link" href="#download">Download</a>
        <a class="site-nav__link" href={repo}>GitHub</a>
        <a class="btn btn--primary" href="#download">↓ Download</a>
      </div>
    </nav>
  </header>

  {/* The opening canvas: headline and product shot share one rounded, tinted
      surface (Gestalt common region) so the above-the-fold reads as a single
      object; the pill nav floats just above it. The download band at the page
      foot mirrors it. See design-system/patterns/hero.md. */}
  <div class="canvas">
    <section class="hero">
      <div class="container">
        <span class="eyebrow hero__eyebrow">Open Knowledge Workspace · {version}</span>
        <h1 class="hero__title">
          Explore connected knowledge<br /><span class="hero__grad">with your agents.</span>
        </h1>
        <p class="hero__sub">
          Open an OKF bundle as a graph and reader, then choose the agent you want
          to work with in the same workspace.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary" href="#download">↓ Download for free</a>
          <a class="btn btn--secondary" href={repo}>View on GitHub</a>
        </div>
        <p class="hero__meta">Free & open source · Windows · macOS · Linux</p>
        <figure class="hero__art">
          <img
            class="zoomable"
            data-spotlight
            role="button"
            tabindex="0"
            src={shotGraph}
            alt="OKF Studio showing a concept graph and reader beside the agent catalog"
            width="1760"
            height="1117"
            fetchpriority="high"
          />
        </figure>
      </div>
    </section>
  </div>

  <main id="main">
    <section class="section" id="formats">
      <div class="container">
        <div class="section__head">
          <span class="eyebrow">New here?</span>
          <h2 class="section__title">What's OKF? What's ODSF?</h2>
          <p class="section__sub">
            OKF Studio reads two open, vendor-neutral formats. Here's the short
            version.
          </p>
        </div>
        <div class="specs">
          <article class="spec-card">
            <span class="spec-card__kicker">Open Knowledge Format</span>
            <h3 class="spec-card__title">Knowledge an agent can read</h3>
            <p class="spec-card__body">
              Google's open spec for packaging knowledge as plain markdown files
              with YAML frontmatter, organized into a portable bundle. No SDK, no
              database, no lock-in. Table docs, runbooks, API references, concept
              graphs: anything an agent or a human should be able to read.
            </p>
            <a class="spec-card__link" href={okfSpec}>Read the OKF spec →</a>
          </article>
          <article class="spec-card">
            <span class="spec-card__kicker">Open Design System Format</span>
            <h3 class="spec-card__title">A design system an agent can build from</h3>
            <p class="spec-card__body">
              A profile of OKF for design systems: it adds machine-readable design
              tokens and runnable HTML/CSS examples, so an agent produces UI that
              matches your system. This very site was built from an ODSF bundle,
              which OKF Studio can open and preview.
            </p>
            <a class="spec-card__link" href={odsfSpec}>Read the ODSF spec →</a>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="features">
      <div class="container">
        <div class="section__head">
          <span class="eyebrow">Why OKF Studio</span>
          <h2 class="section__title">Built to explore knowledge with agents.</h2>
          <p class="section__sub">
            Read the Open Knowledge Format directly, then bring the active bundle
            into an agent thread without moving it to another workspace.
          </p>
        </div>
        <div class="features">
          {
            features.map((f) => (
              <article class="feature-card">
                <span class="feature-card__glyph" aria-hidden="true">{f.glyph}</span>
                <h3 class="feature-card__title">{f.title}</h3>
                <p class="feature-card__body">{f.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="visualizations">
      <div class="container">
        <div class="section__head">
          <span class="eyebrow">Four ways to see it</span>
          <h2 class="section__title">Pick the view that fits the question.</h2>
          <p class="section__sub">
            The same bundle as a network, a treemap, a sunburst, or nested
            circles. Switch with one click, and it opens that way next time.
          </p>
        </div>
        <div class="vizzes">
          {
            vizzes.map((v) => (
              <article class="viz-card">
                <figure class="viz-card__media">
                  <img
                    class="zoomable"
                    data-spotlight
                    role="button"
                    tabindex="0"
                    src={v.src}
                    alt={v.alt}
                    width="1760"
                    height="1117"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
                <div class="viz-card__text">
                  <h3 class="viz-card__title">{v.title}</h3>
                  <p class="viz-card__body">{v.body}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section showcase">
      <div class="container">
        <div class="showcase__row">
          <div class="showcase__text">
            <span class="eyebrow showcase__eyebrow">The reader</span>
            <h2 class="showcase__title">Every concept, its links, and where it's cited.</h2>
            <p class="showcase__body">
              A distraction-free reader with a live index, syntax-highlighted code,
              zoomable images, and the relationship panel. Hover a link to peek at
              its target, open side quests in tabs that keep their own back/forward
              history, and undock a tab into its own window for a second monitor.
            </p>
          </div>
          <figure class="showcase__media">
            <img class="zoomable" data-spotlight role="button" tabindex="0" src={shotReader} alt="OKF Studio's concept reader with the index and relationship panel" width="1760" height="1117" loading="lazy" decoding="async" />
          </figure>
        </div>

        <div class="showcase__row showcase__row--reverse">
          <div class="showcase__text">
            <span class="eyebrow showcase__eyebrow">Design-system aware</span>
            <h2 class="showcase__title">It reads design systems, too.</h2>
            <p class="showcase__body">
              Open an ODSF bundle and OKF Studio renders its design tokens and
              live HTML/CSS examples inline. Inspect resolved values, switch
              between preview and source, and stay inside the reader.
            </p>
          </div>
          <figure class="showcase__media">
            <img class="zoomable" data-spotlight role="button" tabindex="0" src={shotDs} alt="OKF Studio rendering an ODSF design-system bundle with a live component preview" width="1760" height="1117" loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <section class="section" id="download">
      <div class="container">
        {/* The closing band mirrors the opening canvas, so the page opens and
            closes on the same contained shape. */}
        <div class="band">
          <div class="section__head">
            <span class="eyebrow">Download</span>
            <h2 class="section__title">Get OKF Studio</h2>
            <p class="section__sub">Free and open source. Pick your platform.</p>
          </div>
          <div class="download__row">
            {
              downloads.map((d) => (
                <a class="dl-btn" href={d.href}>
                  <span class="dl-btn__glyph" aria-hidden="true">{d.glyph}</span>
                  <span class="dl-btn__text">
                    <span class="dl-btn__os">{d.os}</span>
                    <span class="dl-btn__meta">{d.meta}</span>
                  </span>
                  <span class="dl-btn__arrow" aria-hidden="true">↓</span>
                </a>
              ))
            }
          </div>
          {/* One line: JSX collapses the whitespace around newline-separated
              inline children, which glued the middots to their neighbors. */}
          <p class="download__note">
            {version} · unsigned for now (your OS may warn on first launch) · <a href={releases}>all releases</a> · macOS: <a href={repo}>build from source</a>
          </p>
          <p class="download__note">
            Upgrading from OKF Viewer? Settings and agent profiles stay in place; open retained local folders once to grant them to Rust. <a href={migrationNotes}>Migration notes</a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer__inner">
      <span>OKF Studio, open source. Explore connected knowledge with your agents.</span>
      <div class="footer__links">
        <a href={repo}>GitHub</a>
        <a href={releases}>Releases</a>
        <a href={okfSpec}>OKF</a>
        <a href={odsfSpec}>ODSF</a>
      </div>
    </div>
  </footer>

  <div class="spotlight" data-open="false" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Enlarged screenshot">
    <img alt="" />
  </div>

  <script>
    const overlay = document.querySelector<HTMLElement>(".spotlight");
    const overlayImg = overlay?.querySelector("img");

    function openSpotlight(src: string | null, alt: string | null) {
      if (!overlay || !overlayImg || !src) return;
      overlayImg.src = src;
      overlayImg.alt = alt ?? "";
      overlay.dataset.open = "true";
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }
    function closeSpotlight() {
      if (!overlay) return;
      overlay.dataset.open = "false";
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      overlayImg?.removeAttribute("src");
    }

    for (const el of document.querySelectorAll<HTMLImageElement>("[data-spotlight]")) {
      el.addEventListener("click", () => openSpotlight(el.getAttribute("src"), el.getAttribute("alt")));
      el.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openSpotlight(el.getAttribute("src"), el.getAttribute("alt"));
        }
      });
    }
    overlay?.addEventListener("click", closeSpotlight);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeSpotlight();
    });
  </script>
</Base>
