---
// Home: one product story, not a feature catalogue. Hero, the knowledge-work
// loop, selected product proof, the trust model, the format bridge, and the
// download close. Capability depth lives on the Product routes.
import Shell from "../components/Shell.astro";
import LoopGrid from "../components/LoopGrid.astro";
import { routes } from "../data/routes";
import { trustClaims } from "../data/trust";
import { version, repo, releases, migrationNotes, downloads } from "../data/site";

const base = import.meta.env.BASE_URL;
const shotGraph = `${base}screenshot-graph.webp`;
const shotReader = `${base}screenshot-reader.webp`;

// The reviewed-write pipeline, drawn honestly as a diagram. It stands in for
// a screenshot until the review/Git surfaces have their own captures; it must
// never pretend to be one.
const reviewFlow = [
  { title: "The agent proposes", body: "Changes land in a staged tree, never directly on your files." },
  { title: "You review", body: "Each diff hunk, and each claim before and after." },
  { title: "Studio validates", body: "Deterministic checks against the OKF spec." },
  { title: "Apply and keep", body: "One restorable transaction, committed to Git when you say so." },
];
---

<Shell path="">
  {/* The opening canvas: headline and product shot share one rounded, tinted
      surface (Gestalt common region); the pill nav floats just above it. The
      download band at the page foot mirrors it. See design-system/patterns/hero.md. */}
  <div class="canvas">
    <section class="hero">
      <div class="container">
        <span class="eyebrow hero__eyebrow">OKF Studio · {version}</span>
        <h1 class="hero__title">
          Explore connected knowledge<br /><span class="hero__grad">with your agents.</span>
        </h1>
        <p class="hero__sub">
          A local-first desktop workspace: open an Open Knowledge Format bundle
          as a graph and reader, then work on it with the agent you choose.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={routes.download}>↓ Download for free</a>
          <a class="btn btn--secondary" href="#loop">See how it works</a>
        </div>
        <p class="hero__meta">Free & open source · Windows · macOS · Linux</p>
        <figure class="hero__art">
          <img
            class="zoomable"
            data-spotlight
            role="button"
            tabindex="0"
            src={shotGraph}
            alt="OKF Studio with an agent thread answering a question about the open bundle, beside the concept graph and reader"
            width="1760"
            height="1051"
            fetchpriority="high"
          />
        </figure>
      </div>
    </section>
  </div>

  <main id="main">
    <section class="section" id="loop">
      <div class="container">
        <div class="section__head">
          <span class="eyebrow">Knowledge work</span>
          <h2 class="section__title">Understand. Ask. Improve. Keep.</h2>
          <p class="section__sub">
            Studio keeps reading, asking, revising, and versioning in the same
            workspace. Open any area for the details.
          </p>
        </div>
        <LoopGrid />
      </div>
    </section>

    <section class="section showcase" aria-label="Product proof">
      <div class="container">
        <div class="showcase__row">
          <div class="showcase__text">
            <span class="eyebrow showcase__eyebrow">Understand</span>
            <h2 class="showcase__title">Every concept, its links, and where it's cited.</h2>
            <p class="showcase__body">
              A distraction-free reader with a live index, syntax-highlighted
              code, and the relationship panel. Hover a link to peek at its
              target, and open side quests in tabs that keep their own history.
            </p>
            <a class="showcase__link" href={routes.explore}>Explore knowledge →</a>
          </div>
          <figure class="showcase__media">
            <img class="zoomable" data-spotlight role="button" tabindex="0" src={shotReader} alt="OKF Studio's concept reader with the index and relationship panel" width="1760" height="1117" loading="lazy" decoding="async" />
          </figure>
        </div>

        <div class="showcase__row showcase__row--reverse">
          <div class="showcase__text">
            <span class="eyebrow showcase__eyebrow">Ask</span>
            <h2 class="showcase__title">Ask the bundle, beside the bundle.</h2>
            <p class="showcase__body">
              An agent thread runs next to the graph and reader, answering from
              the open bundle. Context goes in explicitly, and each answer keeps
              a receipt of excerpts and conflicts you can open under Inspect.
            </p>
            <a class="showcase__link" href={routes.agents}>Work with agents →</a>
          </div>
          <figure class="showcase__media">
            <img class="zoomable" data-spotlight role="button" tabindex="0" src={shotGraph} alt="An agent thread in OKF Studio answering a question about the open bundle, beside the concept graph and reader" width="1760" height="1051" loading="lazy" decoding="async" />
          </figure>
        </div>

        <div class="showcase__row">
          <div class="showcase__text">
            <span class="eyebrow showcase__eyebrow">Improve & keep</span>
            <h2 class="showcase__title">Review every change, then keep it.</h2>
            <p class="showcase__body">
              No agent writes to your files. Proposed changes wait in a staged
              tree for your review, pass deterministic validation, and land in
              one restorable transaction with Git history right beside them.
            </p>
            <a class="showcase__link" href={routes.review}>Review and improve →</a>
          </div>
          <div class="showcase__media">
            <div class="flow" role="img" aria-label="The reviewed-write pipeline: the agent proposes into a staged tree, you review each diff, Studio validates against the spec, and the change is applied in one restorable transaction and kept in Git">
              {reviewFlow.map((s, i) => (
                <div class="flow__step">
                  <span class="flow__marker" aria-hidden="true">{i + 1}</span>
                  <div>
                    <p class="flow__title">{s.title}</p>
                    <p class="flow__body">{s.body}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="trust">
      <div class="container">
        <div class="section__head">
          <span class="eyebrow">Trust model</span>
          <h2 class="section__title">You can tell exactly what it does.</h2>
          <p class="section__sub">
            Local files, explicit external activity, user-chosen agents,
            reviewed writes. These are product boundaries, not settings.
          </p>
        </div>
        <div class="trust">
          {
            trustClaims.map((c) => (
              <article class="trust-item">
                <h3 class="trust-item__title">{c.title}</h3>
                <p class="trust-item__body">{c.body}</p>
                <a class="trust-item__link" href={c.href}>{c.linkLabel} →</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="format">
      <div class="container">
        <div class="section__head">
          <span class="eyebrow">The format underneath</span>
          <h2 class="section__title">Plain Markdown, connected.</h2>
          <p class="section__sub">
            Studio works on Open Knowledge Format bundles: portable folders of
            Markdown with structured frontmatter that agents and humans read the
            same way. The bundle needs no database or SDK and remains portable
            between tools. Design systems get the same treatment through ODSF.
          </p>
        </div>
        <div class="hero__cta">
          <a class="btn btn--secondary" href={routes.okf}>What is OKF?</a>
          <a class="btn btn--ghost" href={routes.odsf}>ODSF for design systems →</a>
        </div>
      </div>
    </section>

    <section class="section" id="download">
      <div class="container">
        {/* The closing band mirrors the opening canvas, so the page opens and
            closes on the same contained shape. */}
        <div class="band">
          <div class="section__head">
            <span class="eyebrow">Download</span>
            <h2 class="section__title">Get OKF Studio</h2>
            <p class="section__sub">Free and open source. Pick your platform.</p>
          </div>
          <div class="download__row">
            {
              downloads.map((d) => (
                <a class="dl-btn" href={d.href}>
                  <span class="dl-btn__glyph" aria-hidden="true">{d.glyph}</span>
                  <span class="dl-btn__text">
                    <span class="dl-btn__os">{d.os}</span>
                    <span class="dl-btn__meta">{d.meta}</span>
                  </span>
                  <span class="dl-btn__arrow" aria-hidden="true">↓</span>
                </a>
              ))
            }
          </div>
          {/* One line: JSX collapses the whitespace around newline-separated
              inline children, which glued the middots to their neighbors. */}
          <p class="download__note">
            {version} · unsigned for now (your OS may warn on first launch) · <a href={releases}>all releases</a> · macOS: <a href={repo}>build from source</a>
          </p>
          <p class="download__note">
            Upgrading from OKF Viewer? <a href={migrationNotes}>Migration notes</a> · Requirements and details on the <a href={routes.download}>download page</a>
          </p>
        </div>
      </div>
    </section>
  </main>
</Shell>
