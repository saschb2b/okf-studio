---
// Explore knowledge: reader, graph views, search, lineage.
import FamilyPage from "../../components/FamilyPage.astro";
import { familyById, vizzes } from "../../data/families";

const base = import.meta.env.BASE_URL;
const shotReader = `${base}screenshot-reader.webp`;
---

<FamilyPage
  family={familyById.explore}
  title="Explore knowledge: OKF Studio's reader, graph views, search, and lineage"
  description="Open any conformant OKF bundle in a reader, switch among graph views, search by text and structure, preview links, and trace lineage across hops."
  path="product/explore/"
>
  <section class="story">
    <span class="eyebrow story__eyebrow">The reader</span>
    <div class="story__head">
      <h2 class="story__title">Every concept, its links, and where it is cited.</h2>
      <div>
        <p class="story__body">
          The live index uses the same authored sections as the hierarchy
          views, beside highlighted code, zoomable images, and the relationship
          panel. Navigation stays keyboard-first throughout. Structured claim
          markers open the same durable evidence record shown in the reader
          rail, and public sources are checked only when you ask.
        </p>
      </div>
    </div>
    <figure class="story__media">
      <img class="zoomable" data-spotlight role="button" tabindex="0" src={shotReader} alt="OKF Studio's concept reader with the index and relationship panel" width="1760" height="1117" loading="lazy" decoding="async" />
    </figure>
  </section>

  <div class="cap-group">
    <h2 class="cap-group__title">Read a concept at your own pace</h2>
    <p class="cap-group__lede">
      The reader's Aa control tunes size, width, spacing, and font, and the
      header can pace the concept for you. A focus player shows one word at a
      time, each word held in the spot your eye already looks for and holding it
      there as the sentences change. A guided mode
      leaves the page alone and sweeps a marker through it instead. Both let you
      step back a word or a sentence whenever a line does not land, both stop at
      a table or a code block rather than reading it out as words, and both say
      plainly where a faster pace starts costing you.
    </p>
  </div>

  <div class="cap-group">
    <h2 class="cap-group__title">See the bundle from different angles</h2>
    <p class="cap-group__lede">
      The same bundle as a network, a treemap, a sunburst, or nested circles.
      Authored index sections give the hierarchy meaningful levels. Switch
      with one click, and it opens that way next time.
    </p>
    <div class="vizzes">
      {
        vizzes.map((v) => (
          <article class="viz-card">
            <figure class="viz-card__media">
              <img
                class="zoomable"
                data-spotlight
                role="button"
                tabindex="0"
                src={v.src}
                alt={v.alt}
                width="1760"
                height="1117"
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="viz-card__text">
              <h3 class="viz-card__title">{v.title}</h3>
              <p class="viz-card__body">{v.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</FamilyPage>
